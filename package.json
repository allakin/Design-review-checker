{
  "name": "design-review-checker",
  "version": "1.2.0",
  "private": true,
  "description": "Design Review Checker — расширение браузера для дизайн-ревью вёрстки. Здесь — тесты и служебные скрипты.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" \"tests/**/*.test.js\"",
    "badges": "node scripts/badges.js",
    "changelog-prepend": "node scripts/changelog-prepend.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
