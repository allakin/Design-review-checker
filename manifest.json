{
  "manifest_version": 3,
  "name": "Design Review Checker",
  "short_name": "Design Review",
  "version": "1.0.0",
  "description": "Дизайн-ревью прямо в браузере: выделяете элемент, расширение делает его скриншот, вы описываете замечание и экспортируете отчёт в HTML или PDF.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Design Review",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "start-pick": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Выбрать элемент для замечания"
    }
  }
}
